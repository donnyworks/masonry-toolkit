[sub_resource type="GDScript" id="GDScript_vwovw"]
resource_name = "npc_spotter"
script/source = "extends CharacterBody3D
class_name npc_spotter_i


signal corpse_created



enum {STATE_PATROLING, STATE_FOLLOWING, STATE_CATCHED, STATE_CATCHED_SUCCESS, STATE_QUESTIONING, STATE_RETURNING, STATE_IDLE, STATE_DEAD}

enum {ATTACK_LIGHTBURST, ATTACK_BUMPER, ATTACK_LASER}

@export var patrolPath: Path3D

@export var isROTORControlled: bool = false

@export_enum(\"Light-Burst\", \"Bumper\", \"Laser\") var attackType: int = 0

@export var spotterSeeThru: bool = true

@export_range(0.001, 32) var updateRate: float = 0.1

@export var debugPoints: bool = false
@export_group(\"Light Colors\")
@export var colorPatrolling: Color = Color.GREEN
@export var colorPatrollingROTOR: Color = Color.CYAN
@export var colorSpotted: Color = Color.YELLOW
@export var colorQuestioning: Color = Color.ORANGE
@export var colorCountdown1: Color = Color.WHITE
@export var colorCountdown2: Color = Color.RED
@export var colorStrobe1: Color = Color.WHITE
@export var colorStrobe2: Color = Color.BLACK


const HEALTH_MAX: int = 50
const HEALTH_MAX_ROTOR: int = 300
const SPEED_PATROL: float = 2.0
const SPEED_CHASE: float = 5.0
const SPEED_ROTATION: float = 4.0
const SPEED_ROTATION_CHASE: float = 8.0
const TARGET_DISTANCE_THRESHOLD: float = 1.0
const TARGET_DISTANCE_CLOSE_THRESHOLD: float = 8.0
const BLADE_SPEED: float = 800.0
const AWARENESS_NORMAL: float = 1.0
const AWARENESS_ALERT: float = 8.0
const AWARENESS_ALERT_EASY: float = 4.0
const DAMAGE_FORCE: float = 4.0
const ATTACK_INTERRUPT_COOLDOWN: float = 0.5


@onready var spotterCarcass = preload(\"res://instances/optimal/os95plus_spotterCarcass.tscn\")


@onready var SOUNDS_CATCH = preload(\"res://sound/spotter/spotter_catch.wav\")
@onready var SOUNDS_COUNTDOWN = preload(\"res://sound/spotter/spotter_countdown.wav\")
@onready var SOUNDS_SPOT = preload(\"res://sound/spotter/spotter_spot.wav\")
@onready var SOUNDS_QUESTIONING = preload(\"res://sound/spotter/spotter_questioning.wav\")
@onready var SOUNDS_BACKTOPATROL = preload(\"res://sound/spotter/spotter_backtopatrol.wav\")

@onready var SOUNDS_DAMAGE = [
	preload(\"res://sound/spotter/spotter_damage1.wav\"), 
	preload(\"res://sound/spotter/spotter_damage2.wav\")
]
@onready var SOUNDS_DEAD = [
	preload(\"res://sound/spotter/spotter_dead1.wav\"), 
	preload(\"res://sound/spotter/spotter_dead2.wav\")
]
@onready var SOUNDS_SPARK = [
	preload(\"res://sound/ebaton/ebaton_swing1.wav\"), 
	preload(\"res://sound/ebaton/ebaton_swing2.wav\"), 
	preload(\"res://sound/ebaton/ebaton_swing3.wav\")
]


@onready var patrolCast: RayCast3D = $collision / patrolCast
@onready var patrolMarker: Marker3D = $collision / patrolCast / patrolMarker



@onready var navAgent: NavigationAgent3D = $navAgent
@onready var particleSpark: GPUParticles3D = $particleSpark
@onready var particleRotor: GPUParticles3D = $particleRotor
@onready var eyesightCastRay = $collision / eyesightCastRay
@onready var eye = $snapper / eye
@onready var lights: Node3D = $Lights
@onready var spotLight = $Lights / Dynamic / spotLight
@onready var spinBlade = $snapper / spinBlade
@onready var sndSpark = $particleSpark / sndSpark
@onready var awarenessArea = $spacialAwarenessArea
@onready var sounds = $sounds
@onready var soundsAttack = $soundsAttack
@onready var timerProcessState = $timerProcessState
@onready var timerBlindChase = $timerBlindChase
@onready var timerQuestioning = $timerQuestioning
@onready var timerQuestioningTurn = $timerQuestioningTurn
@onready var timerCountdown = $timerCountdown

@onready var lightsDynamic: Node3D = $Lights / Dynamic
@onready var lightsCheap: Node3D = $Lights / Cheap

@onready var spotLightCheap: Decal = $Lights / Cheap / spotLightCheap


@onready var startGoal: Vector3 = global_position
var endGoal: Vector3 = Vector3.ZERO

@onready var health = HEALTH_MAX
@onready var eyeMaterial: StandardMaterial3D = eye.mesh.get(\"surface_0/material\")


var state: int = STATE_PATROLING

var time: float = 0
var attacking: bool = false

var targetGoal: Vector3 = Vector3.ZERO
var targetNode: Node3D = null
var potentialTarget: Node3D = null
var awarenessAlert: float = AWARENESS_ALERT


var direction = Vector3.ZERO
var speed: float = SPEED_PATROL
var speedRotation: float = SPEED_ROTATION

var movement: Vector3 = Vector3.ZERO
var hoverY: float = 0


var currentCarcass: RigidBody3D

func _ready():
	particleRotor.emitting = isROTORControlled
	if isROTORControlled:
		health = HEALTH_MAX_ROTOR
	else:
		health = HEALTH_MAX
	patrolCast.add_exception(self)
	eyesightCastRay.add_exception(self)
	#difficultyChanged(GameConfig.difficulty)
	#GlobalFuncs.connect(\"difficultyChanged\", difficultyChanged)
	#SaveHandler.connect(\"settings_saved\", updateLights)
	updateLights()
	timerProcessState.wait_time = updateRate

	eyeMaterial = eyeMaterial.duplicate()
	eye.material_override = eyeMaterial
	lights.reparent(eye)
	eyeMaterial.albedo_color = Color.GRAY
	eyeMaterial.emission_operator = BaseMaterial3D.EMISSION_OP_MULTIPLY

	endGoal = patrolMarker.global_position
	setState(STATE_PATROLING)
	await get_tree().process_frame

	var change: bool = targetGoal == endGoal
	if patrolCast.is_colliding():
		endGoal = patrolCast.get_collision_point()
		if debugPoints:
			makeDebugPoints()
		if change:
			targetGoal = endGoal

	if spotterSeeThru:
		for i in get_tree().get_nodes_in_group(\"npc_spotter\"):
			if i != self:
				eyesightCastRay.add_exception(i)


func setState(newState: int = STATE_PATROLING):
	state = newState
	timerProcessState.wait_time = updateRate
	timerQuestioningTurn.stop()
	match state:
		STATE_PATROLING:
			awarenessArea.scale = Vector3.ONE * AWARENESS_NORMAL
			speed = SPEED_PATROL
			speedRotation = SPEED_ROTATION
			if isROTORControlled:
				setSpotLight(colorPatrollingROTOR)
			else:
				setSpotLight(colorPatrolling)

			if patrolPath:
				pass
			else:
				targetGoal = endGoal
			updateDirection()
		STATE_FOLLOWING:
			sounds.stream = SOUNDS_SPOT
			sounds.play()
			awarenessArea.scale = Vector3.ONE * awarenessAlert
			speed = SPEED_CHASE
			speedRotation = SPEED_ROTATION_CHASE
			setSpotLight(colorSpotted)

			if targetNode:
				targetGoal = targetNode.global_position
			updateDirection()
			_on_timer_process_state_timeout()

		STATE_QUESTIONING:
			awarenessArea.scale = Vector3.ONE * awarenessAlert
			setSpotLight(colorQuestioning)
			sounds.stream = SOUNDS_QUESTIONING
			sounds.play()
			timerQuestioning.start()
			timerQuestioningTurn.start()
			direction = - direction

		STATE_RETURNING:
			awarenessArea.scale = Vector3.ONE * AWARENESS_NORMAL
			speed = SPEED_PATROL
			speedRotation = SPEED_ROTATION
			if isROTORControlled:
				setSpotLight(colorPatrollingROTOR)
			else:
				setSpotLight(colorPatrolling)
			sounds.stream = SOUNDS_BACKTOPATROL
			sounds.play()

func updateDirection():
	direction = global_position.direction_to(targetGoal)

func testPotentialTarget():
	if potentialTarget:

		eyesightCastRay.target_position = eyesightCastRay.to_local(potentialTarget.global_position)
		if eyesightCastRay.is_colliding():

			if eyesightCastRay.get_collider() == potentialTarget:
				bodySeen(potentialTarget)
				return true
	return false

func takeDamage(amount: int = 0, hitDirection: Vector3 = Vector3.ZERO, point: Vector3 = global_position):
	health = clamp(health - amount, 0, 1000)
	var newParticle = particleSpark.duplicate()
	newParticle.template = false
	sndSpark.stream = SOUNDS_SPARK.pick_random()
	movement += Vector3.ONE * DAMAGE_FORCE * hitDirection
	add_child(newParticle)
	newParticle.global_position = point
	newParticle.restart()
	if !isROTORControlled:
		cancelAttack(true)
	if health <= 0:
		death(true, hitDirection)
		return

	sounds.stream = SOUNDS_DAMAGE.pick_random()
	sounds.play()
	match state:
		STATE_PATROLING, STATE_RETURNING:
			setState(STATE_QUESTIONING)

func death(sound: bool = false, hitDirection: Vector3 = Vector3.ZERO):
	setState(STATE_DEAD)
	visible = false
	process_mode = Node.PROCESS_MODE_DISABLED
	velocity = Vector3.ZERO
	var carcass: RigidBody3D = spotterCarcass.instantiate()
	carcass.add_to_group(\"+unsavable\")
	get_parent().add_child(carcass)
	carcass.global_position = global_position
	carcass.global_rotation = global_rotation + Vector3(0, PI, 0)
	carcass.linear_velocity += Vector3.ONE * DAMAGE_FORCE * hitDirection * 2.0
	if sound:
		var spClone: AudioStreamPlayer3D = sounds.duplicate()
		spClone.stream = SOUNDS_DEAD.pick_random()
		carcass.add_child(spClone)
		spClone.connect(\"finished\", spClone.queue_free)
		spClone.play()
	currentCarcass = carcass

func bodySeen(body: Node3D):
	if body is FPSC_Player:
		targetNode = body
		setState(STATE_FOLLOWING)

	if body is npc_spotter_i:
		if state == STATE_PATROLING or state == STATE_RETURNING:
			if body.state == STATE_FOLLOWING or body.state == STATE_CATCHED:
				setState(STATE_QUESTIONING)

func _on_timer_process_state_timeout():
	match state:
		STATE_PATROLING:
			testPotentialTarget()
			if global_position.distance_squared_to(targetGoal) < TARGET_DISTANCE_THRESHOLD:
				if patrolPath:
					pass
				else:
					if targetGoal == startGoal:
						targetGoal = endGoal
					else:
						targetGoal = startGoal
			updateDirection()
		STATE_FOLLOWING:
			var foundTarget: bool = false
			if targetNode:
				foundTarget = await findTarget(targetNode)


			match attackType:
				ATTACK_LIGHTBURST:
					if global_position.distance_squared_to(targetNode.global_position) < TARGET_DISTANCE_CLOSE_THRESHOLD:
						var shouldAttack: bool = true
						if targetNode is FPSC_Player:
							if targetNode.health <= 0:
								shouldAttack = false
						if !attacking and shouldAttack:
							tryAttack(attackType)
					else:
						cancelAttack()


			if global_position.distance_squared_to(targetGoal) < TARGET_DISTANCE_THRESHOLD:
				if foundTarget:
					timerBlindChase.stop()
				else:


					if timerBlindChase.is_stopped():
						timerBlindChase.start()
			updateDirection()
		STATE_QUESTIONING:
			if testPotentialTarget():
				timerQuestioning.stop()


func findTarget(target: Node):
	eyesightCastRay.target_position = eyesightCastRay.to_local(target.global_position)
	await get_tree().process_frame
	eyesightCastRay.target_position = eyesightCastRay.to_local(target.global_position)
	if eyesightCastRay.is_colliding():
		var collider: Node3D = eyesightCastRay.get_collider()
		if collider == target:
			targetGoal = target.global_position
			return true
	return false

func tryAttack(type: int):
	match type:
		ATTACK_LIGHTBURST:
			attacking = true
			setSpotLight(colorCountdown2)
			sounds.stop()
			soundsAttack.stream = SOUNDS_COUNTDOWN
			soundsAttack.play()
			timerCountdown.start()

func cancelAttack(cooldown: bool = false):
	if attacking:
		match attackType:
			ATTACK_LIGHTBURST:
				soundsAttack.stop()
				timerCountdown.stop()
				setSpotLight(colorSpotted)
				sounds.stream = SOUNDS_SPOT
				sounds.play()
	if cooldown:
		await get_tree().create_timer(ATTACK_INTERRUPT_COOLDOWN, false).timeout
	attacking = false

func makeDebugPoints():
	var b = CSGSphere3D.new()
	b.radius = 0.5
	b.material = StandardMaterial3D.new()
	b.material.no_depth_test = true
	b.material.transparency = 1
	b.material.albedo_color = Color(0, 1, 0, 0.25)
	b.position = global_position
	get_tree().current_scene.add_child(b)
	var c = CSGSphere3D.new()
	c.radius = 0.5
	c.material = StandardMaterial3D.new()
	c.material.no_depth_test = true
	c.material.transparency = 1
	c.material.albedo_color = Color(1, 0, 0, 0.25)
	c.position = patrolCast.get_collision_point()
	get_tree().current_scene.add_child(c)

func setSpotLight(color: Color):
	eyeMaterial.emission = color
	spotLight.light_color = color
	spotLightCheap.modulate = color

func updateLights():
	lightsDynamic.visible = true
	lightsCheap.visible = false


func _on_sounds_attack_finished():
	if soundsAttack.stream == SOUNDS_COUNTDOWN:
		sounds.stream = SOUNDS_CATCH
		sounds.play()
		timerCountdown.stop()
		attacking = false
		if targetNode is FPSC_Player:
			targetNode.health = 0

			targetNode.FPSC_ExecuteFade(Color(1,1,1),FPSC_Player.FadeTypes.FADE_OUT,2.0)

func _on_timer_countdown_timeout():
	setSpotLight(colorCountdown2 if eyeMaterial.emission == colorCountdown1 else colorCountdown1)

func _on_timer_blind_chase_timeout():
	setState(STATE_QUESTIONING)

func _on_timer_questioning_timeout():
	setState(STATE_RETURNING)

func _on_timer_questioning_turn_timeout():
	if state == STATE_QUESTIONING:
		direction = - direction

func _physics_process(delta):
	spinBlade.rotation_degrees.y += delta * BLADE_SPEED
	time += delta

	match state:
		STATE_FOLLOWING:
			if targetNode:
				eye.look_at(targetNode.global_position, Vector3.UP, true)
				direction = global_position.direction_to(targetNode.global_position)
				rotation.y = lerp_angle(rotation.y, atan2( - direction.x, - direction.z), speedRotation * delta)
			else:
				setState(STATE_QUESTIONING)
			movement = movement.lerp(direction * speed, delta)
		STATE_QUESTIONING:
			rotation.y += speedRotation * delta
			eye.rotation = Vector3.ZERO
			movement = movement.lerp(Vector3.ZERO * speed, delta)
		_:
			rotation.y = lerp_angle(rotation.y, atan2( - direction.x, - direction.z), speedRotation * delta)
			eye.rotation = Vector3.ZERO
			movement = movement.lerp(direction * speed, delta)


	hoverY = sin(time * 250 * delta) * 0.5

	velocity = movement + Vector3(0, hoverY, 0)
	move_and_slide()

func _on_eyesightArea_body_entered(body):
	if body is FPSC_Player:

		if !potentialTarget is FPSC_Player:
			potentialTarget = body

func _on_eyesightArea_body_exited(body):
	if body == potentialTarget:
		potentialTarget = null

func _on_spacialAwarenessArea_body_entered(body):
	match state:
		STATE_PATROLING, STATE_RETURNING:
			if body is FPSC_Player:
				setState(STATE_QUESTIONING)

func saveVars():
	var carcassDict: Dictionary = {}
	if currentCarcass:
		carcassDict = {
			\"global_transform\": currentCarcass.global_transform, 
			\"linear_velocity\": currentCarcass.linear_velocity, 
			\"angular_velocity\": currentCarcass.angular_velocity
		}
	var vars = {
		\"class\": \"savable\", 
		\"path\": get_path(), 
		\"global_transform\": global_transform, 
		\"movement\": movement, 
		\"state\": state, 
		\"carcassDict\": carcassDict
	}
	return vars

func loadVars(vars: Dictionary):
	global_transform = vars.global_transform
	movement = vars.movement
	match vars.state:
		STATE_DEAD:
			if !vars.carcassDict.is_empty():
				death(false)
				currentCarcass.global_transform = vars.carcassDict.global_transform
				currentCarcass.linear_velocity = vars.carcassDict.linear_velocity
				currentCarcass.angular_velocity = vars.carcassDict.angular_velocity
"

