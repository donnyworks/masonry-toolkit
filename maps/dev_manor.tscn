[sub_resource type="GDScript" id="GDScript_ui3mt"]
resource_name = "jumper"
script/source = "extends CSGBox3D

@onready var basePos = position

func _process(delta: float) -> void:
	if position.y > basePos.y:
		position.y -= 9.8*delta
	if randi_range(0,1000) == 1000:
		var t = create_tween()
		t.tween_property(self,\"position\",Vector3(position.x,position.y + 1,position.z),0.5)
"

