[sub_resource type="GDScript" id="GDScript_nusyj"]
resource_name = "dialog"
script/source = "extends Control

var sound = \"SND_TXT1.wav\"

@export var texts : Array[String] = [\"La la la~\\nTime to wake up and smell the pain.\",\"Or{.{.{. $will the pain smell me?\"]

var current_text = 0

var current_character = 0

var textSpeed = 0.05

var playerRef = null

@export var comp : CanvasItem = null

func _ready():
	visible = false

# Called when the node enters the scene tree for the first time.
func onTriggered() -> void:
	await get_tree().process_frame
	await get_tree().process_frame
	visible = true
	print(\"Dialog system waking up...\")
	#$AudioStreamPlayer.stream = load(\"res://Sounds/\" + sound)
	$chwait.start(textSpeed)
	pass # Replace with function body.

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if not visible: return
	if Input.is_action_just_pressed(\"p_use\"):
		print(\"Advance.\")
		if current_text + 1 < len(texts):
			current_text += 1
			current_character = 0
			$HBoxContainer/currentText.text = \"\"
		else:
			#GlobalScope.UIEvents.erase(GlobalScope.EventTypes.IN_DIALOG)
			#GlobalScope.CurrentEvent = GlobalScope.EventTypes.FREED
			if comp != null:
				comp.visible = true
			#	get_node(comp).activated(playerRef,self)
			queue_free()
	if Input.is_action_just_pressed(\"p_flashlight\"):
		$HBoxContainer/currentText.text = texts[current_text].replace(\"$\",\"\").replace(\"{\",\"\")
		current_character = len(texts[current_text])
	pass


func _on_chwait_timeout() -> void:
	#print(\"Typing character...\")
	if current_character < len(texts[current_text]):
		if texts[current_text][current_character] == \"$\":
			current_character += 1
			$chwait.start(0.5)
		elif texts[current_text][current_character] == \"{\":
			current_character += 1
			$chwait.start(0.25)
		else:
			$HBoxContainer/currentText.text += texts[current_text][current_character]
			$AudioStreamPlayer.play()
			current_character += 1
			$chwait.start(textSpeed)
	pass # Replace with function body.
"

[sub_resource type="GDScript" id="GDScript_041m3"]
resource_name = "DLGActivatable"
script/source = "extends FPSC_Activatable

func on_enter(_body:Node3D):
	if not get_parent().get_parent().get_parent().visible:
		return
	get_parent().get_node(\"Dialog\").onTriggered()
	queue_free()
"

